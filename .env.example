# Leave empty to use the Vite same-origin proxy (recommended for local dev).
# Set to http://localhost:8000 only when talking to the API directly (requires
# FISCALFLOW_CORS_ORIGINS to include http://localhost:5173 on the backend).
VITE_API_BASE_URL=

# Optional bearer token — must match FISCALFLOW_API_TOKEN on the backend when set.
VITE_API_TOKEN=
