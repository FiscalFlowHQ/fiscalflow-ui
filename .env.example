# Leave empty to use the Vite same-origin proxy (recommended for browser local dev).
# Set to http://localhost:8000 when talking to the API directly (requires matching
# FISCALFLOW_CORS_ORIGINS on the backend). Tauri release builds inject this via
# beforeBuildCommand; under Tauri an empty value also defaults to localhost:8000 at runtime.
# Runtime override: Settings → API base URL (localStorage fiscalflow.settings.v1).
VITE_API_BASE_URL=

# Optional bearer token — must match FISCALFLOW_API_TOKEN on the backend when set.
# Runtime override: Settings → Bearer token.
VITE_API_TOKEN=
